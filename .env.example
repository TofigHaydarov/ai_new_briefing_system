# Copy this to .env and fill in real values. DO NOT commit .env.

# --- LLM (for summary + labeling) ---
# anthropic | openai | gemini
LLM_PROVIDER=anthropic
# provider-specific model id      
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Embeddings (semantic dedup, optional clustering) ---
# openai | gemini  (Anthropic has no embedding API)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# (uses OPENAI_API_KEY or GOOGLE_API_KEY above)

# --- SE-layer settings ---
LOG_LEVEL=INFO
DIGESTS_DIR=./digests
DEDUP_NEAR_DUPLICATE_THRESHOLD=0.70
FETCH_TIMEOUT_SECONDS=10
MAX_PARALLEL_FETCHES=5
